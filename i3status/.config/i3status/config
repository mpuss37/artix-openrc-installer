general {
        colors = true
        interval = 5
}

#order += "wireless _first_"
order += "wireless wlan0"
order += "wireless wlan1"
order += "volume master"
order += "battery all"
order += "tztime local"

wireless wlan0 {
        format_up = "W0(%quality at %essid) %ip"
        format_down = "W: down"
}

wireless wlan1 {
        format_up = "W1(%quality at %essid) %ip"
        format_down = "W: down"
}

volume master {
        format = " Vol: %volume"
        format_muted = " Mute: %volume"
        device = "default"
        mixer = "Master"
        mixer_idx = 0
}

ethernet _first_ {
        format_up = "E: %ip (%speed)"
        format_down = "E: down"
}

battery all {
        format = "%status %percentage %remaining"
        last_full_capacity = true
}

disk "/" {
        format = "%avail"
}

load {
        format = "%1min"
}

memory {
        format = "%used | %available"
        threshold_degraded = "1G"
        format_degraded = "MEMORY < %available"
}

tztime local {
        format = "%Y-%m-%d %H:%M"
}
